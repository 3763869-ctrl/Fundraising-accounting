# Supabase project settings. Use the public publishable key, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Planned Sola (formerly Cardknox) server integration; never prefix with NEXT_PUBLIC_.
# Enter the live value directly in Vercel's sensitive Production environment settings.
# No Sola processing adapter currently consumes this variable; saving it enables no charges.
SOLA_API_KEY=

# Separate browser-safe iFields key ONLY, after Sola confirms its domain/key configuration.
# Never place the Standard merchant API key in this field.
NEXT_PUBLIC_SOLA_IFIELDS_KEY=

# Isolated sandbox secure-field check. Set only in a separate Preview/development
# deployment using a separate non-production Supabase project and sandbox key.
# Production rejects this feature even if the flag is set.
SOLA_SANDBOX_ENABLED=false
SOLA_SANDBOX_IFIELDS_KEY=
SOLA_SANDBOX_ORGANIZATION_ID=
