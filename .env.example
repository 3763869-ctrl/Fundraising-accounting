# Supabase project settings. Use the public publishable key, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sola (formerly Cardknox) server integration; never prefix with NEXT_PUBLIC_.
# Enter the live value directly in Vercel's sensitive Production environment settings.
# Used only by owner-authorized server card entry. No automated charges are enabled.
SOLA_API_KEY=

# Separate browser-safe iFields key ONLY, after Sola confirms its domain/key configuration.
# Never place the Standard merchant API key in this field.
NEXT_PUBLIC_SOLA_IFIELDS_KEY=

# Isolated sandbox secure-field check. Set only in a separate Preview/development
# deployment using a separate non-production Supabase project and sandbox key.
# Production rejects this feature even if the flag is set.
SOLA_SANDBOX_ENABLED=false
SOLA_SANDBOX_IFIELDS_KEY=
SOLA_SANDBOX_ORGANIZATION_ID=

# Live card entry: server-only settings, Production only. No live keys in Preview.
# Privileged Supabase key is used only for server-verified payment finalization.
SUPABASE_SERVICE_ROLE_KEY=
SOLA_OWNER_EMAIL=
SOLA_LIVE_PAYMENTS_ENABLED=false
# Initial per-payment limit in USD cents ($100). Server enforced.
SOLA_MAX_CHARGE_MINOR=10000

# Server-only card vault encryption key: independent 32-byte secret encoded as 64 hex characters.
# Production sensitive setting. Do not rotate without migrating existing encrypted tokens.
SOLA_CARD_VAULT_KEY=

# Matbia: separate production validation token and recipient profile key.
# Sensitive server-only Production settings. Never copy public sandbox fixtures here.
MATBIA_API_TOKEN=
MATBIA_ORG_USER_HANDLE=
# Optional; defaults to the existing verified SOLA_OWNER_EMAIL.
MATBIA_OWNER_EMAIL=
MATBIA_LIVE_PAYMENTS_ENABLED=false
# Enable only after Matbia approves the documented direct card-entry handling.
MATBIA_DIRECT_ENTRY_APPROVED=false
MATBIA_MAX_CHARGE_MINOR=10000
